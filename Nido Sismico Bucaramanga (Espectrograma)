    "        # --- Reescalar a 48 kHz (audio estándar) ---\n",
    "        target_sr = 48000\n",
    "        data_audio = sig.resample(data_fast, int(len(data_fast) * (target_sr / tr.stats.sampling_rate)))\n",
    "\n",
    "        # --- Guardar como WAV ---\n",
    "        filename = f\"6_{net}_{sta}_Bucaramanga2025_1min.wav\"\n",
