    "from obspy import UTCDateTime\n",
    "from obspy.clients.fdsn import Client\n",
    "from obspy.clients.fdsn.header import FDSNNoDataException\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "\n",
    "client = Client(\"IRIS\")\n",
    "os.makedirs(\"sismogramas_jpg\", exist_ok=True)\n",
    "\n",
    "for i, (time_str, lat, lon, mag) in enumerate(events, 1):\n",
    "    origin_time = UTCDateTime(time_str)\n",
    "    print(f\"\\n Evento {i}: {time_str}  |  M={mag}\")\n",
    "\n",
    "    inv = client.get_stations(latitude=lat, longitude=lon,\n",
    "                              maxradius=5, channel=\"BH?\", level=\"channel\")\n",
    "\n",
    "    guardado = False\n",
    "    for net in inv:\n",
    "        for sta in net:\n",
    "            network, station = net.code, sta.code\n",
    "\n",
    "            try:\n",
    "                st = client.get_waveforms(network=network, station=station,\n",
    "                                          location=\"*\", channel=\"BH?\",\n",
    "                                          starttime=origin_time - 60,\n",
    "                                          endtime=origin_time + 240)\n",
    "            except FDSNNoDataException:\n",
    "                print(f\"  - {network}.{station}: sin datos\")\n",
    "                continue\n",
    "            except Exception as e:\n",
    "                print(f\"  {network}.{station}: {e}\")\n",
    "                continue\n",
    "\n",
    "            st.detrend(\"linear\")\n",
    "\n",
    "            # Filtro adaptado a la frecuencia de muestreo de cada traza\n",
    "            for tr in st:\n",
    "                nyquist = tr.stats.sampling_rate / 2\n",
    "                tr.filter(\"bandpass\", freqmin=0.5, freqmax=min(10, nyquist * 0.9))\n",
    "\n",
    "            # --- Graficar\n",
    "            fig, ax = plt.subplots(figsize=(10, 4))\n",
    "            for tr in st:\n",
    "                ax.plot(tr.times(\"relative\"), tr.data, label=tr.id)\n",
    "\n",
    "            ax.set_title(f\"Evento {i} - {time_str}\\n\"\n",
    "                         f\"{network}.{station}  |  Magnitud {mag}\")\n",
    "            ax.set_xlabel(\"Tiempo (s)\")\n",
    "            ax.set_ylabel(\"Amplitud\")\n",
    "            ax.legend(loc=\"upper right\", fontsize=8)\n",
    "            plt.tight_layout()\n",
