    "    ax.set_ylim(0, 3000)          # adjust: dominant energy is ~150–7000 Hz\n",
    "    ax.set_ylabel(\"Frecuencia [Hz]\")\n",
    "    ax.set_title(f\"Espectrograma de Gabor (σ = {s*1000:.0f} ms)\")\n",
    "    fig.colorbar(pcm, ax=ax, label=\"Potencia [dB]\")\n",
