    "from scipy.signal import stft\n",
    "from scipy.signal.windows import gaussian\n",
    "\n",
    "def gabor_spectrogram(x, fs, sigma_t, overlap=0.9, nfft=None):\n",
    "    \"\"\"\n",
    "    Gabor transform = STFT with a Gaussian window.\n",
    "    sigma_t : standard deviation of the window in seconds\n",
    "              (small -> good time resolution, large -> good frequency resolution)\n",
    "    \"\"\"\n",
    "    std = sigma_t * fs                       # sigma in samples\n",
    "    nperseg = int(2 * np.ceil(3 * std) + 1)  # window covers ±3σ\n",
    "    win = gaussian(nperseg, std=std)\n",
    "    noverlap = int(nperseg * overlap)\n",
    "    nfft = nfft or max(2048, nperseg)\n",
    "    f, t, Z = stft(x, fs=fs, window=win, nperseg=nperseg,\n",
    "                   noverlap=noverlap, nfft=nfft, boundary='zeros')\n",
    "    return f, t, np.abs(Z)**2                # power\n",
    "\n",
    "# --- Compare different window widths ---\n",
    "sigmas = [0.005, 0.02, 0.08]   # 5 ms, 20 ms, 80 ms\n",
    "fig, axes = plt.subplots(len(sigmas), 1, figsize=(10, 9), sharex=True)\n",
    "\n",
