    "from obspy import UTCDateTime\n",
    "from obspy.clients.fdsn import Client\n",
    "from obspy import Stream\n",
    "\n",
    "client = Client(\"IRIS\")\n",
    "\n",
    "# --- Eventos tomados directamente del catálogo USGS (celda 2) ---\n",
    "events = []\n",
    "for ev in cat:\n",
    "    origen = ev.preferred_origin() or ev.origins[0]\n",
    "    magnitud = ev.preferred_magnitude() or ev.magnitudes[0]\n",
    "    events.append((str(origen.time), origen.latitude, origen.longitude, magnitud.mag))\n",
    "\n",
    "# Ordenar del más reciente al más antiguo (como tu lista original)\n",
    "events.sort(key=lambda e: e[0], reverse=True)\n",
    "\n",
    "print(f\"{len(events)} eventos cargados desde el catálogo\")\n",
    "for e in events:\n",
    "    print(e)\n",
    "\n",
    "# Estación ejemplo (podemos cambiar luego)\n",
    "network = \"IU\"    # Red global\n",
    "station = \"COLA\"  # Estación de referencia en Colombia\n",
    "channel = \"BH?\"   # Banda ancha\n",
    "location = \"*\"\n",
    "\n",
    "st_all = Stream()\n",
    "\n",
    "for time_str, lat, lon, mag in events:\n",
    "    origin_time = UTCDateTime(time_str)\n",
    "\n",
    "    try:\n",
    "        st = client.get_waveforms(network=network, station=station,\n",
    "                                  location=location, channel=channel,\n",
    "                                  starttime=origin_time - 60,\n",
    "                                  endtime=origin_time + 300)\n",
    "        print(f\"Descargado evento {time_str} ({mag} Mw)\")\n",
    "\n",
    "        # Procesamiento básico\n",
    "        st.detrend(\"linear\")\n",
    "        st.filter(\"bandpass\", freqmin=0.5, freqmax=10)\n",
    "        st_all += st\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"No se pudo descargar {time_str}: {e}\")\n",
    "\n",
    "# Convertir a float32 (la mitad de tamaño que float64) y escribir con la codificación correcta\n",
    "for tr in st_all:\n",
    "    tr.data = tr.data.astype(\"float32\")\n",
    "\n",
    "st_all.write(\"sismogramas_bucaramanga.mseed\", format=\"MSEED\", encoding=\"FLOAT32\")\n",
    "print(\"Archivo guardado como sismogramas_bucaramanga.mseed\")\n"
   ]
